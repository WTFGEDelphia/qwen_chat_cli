# Qwen Studio 账号信息
# QWEN_PASSWORD 填写明文密码；程序会在登录请求前进行 SHA256 哈希。
QWEN_EMAIL=your_email@gmail.com
QWEN_PASSWORD=your_plain_password

# API 密钥（用于客户端认证）
# 对外监听时必须改成强随机值，不能使用默认示例值。
API_KEY=sk-qwen-studio-123456

# 运行模式：stateless | stateful
RUN_MODE=stateful

# 默认只监听本机
HOST=127.0.0.1
PORT=8000

# 可选：逗号分隔的浏览器调用来源白名单
CORS_ALLOW_ORIGINS=
