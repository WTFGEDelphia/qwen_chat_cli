# Qwen 认证配置
QWEN_EMAIL=your_email@example.com
QWEN_PASSWORD=your_password

# API 密钥
API_KEY=your_api_key

# 运行模式
RUN_MODE=stateful

# 服务器配置
HOST=127.0.0.1
PORT=8000

# CORS 配置
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 兼容模式: strict(拒绝不支持的字段返回400) | lenient(静默忽略不支持的字段，默认)
# COMPAT_MODE=lenient

# 模型缓存配置（MODEL_CACHE_DIR 默认为 ~/.cache/qwen_gateway/）
MODEL_CACHE_TTL=1800
# MODEL_CACHE_DIR=
MODEL_CACHE_REFRESH_INTERVAL=1800
